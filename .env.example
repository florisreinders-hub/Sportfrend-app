# Supabase project settings (Project Settings -> API in the Supabase dashboard)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# RevenueCat public SDK keys (RevenueCat dashboard -> Project settings -> API keys),
# for the Betalen (payment) screen's Premium/Elite in-app purchases.
# Not read by the app yet - PaymentScreen currently runs in a sandbox mode
# that doesn't call RevenueCat at all. See the "RevenueCat" section in
# README.md for the full setup steps and why installing the SDK needs a
# custom EAS build instead of Expo Go.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
