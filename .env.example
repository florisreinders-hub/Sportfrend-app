# Supabase project settings (Project Settings -> API in the Supabase dashboard)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# RevenueCat public SDK keys (RevenueCat dashboard -> Project settings -> API keys),
# for the Betalen (payment) screen's Premium/Elite in-app purchases.
# Not read by the app yet - PaymentScreen currently runs in a sandbox mode
# that doesn't call RevenueCat at all. See the "RevenueCat" section in
# README.md for the full setup steps and why installing the SDK needs a
# custom EAS build instead of Expo Go.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Sentry crash-reporting (see README.md's "Sentry crash-reporting" section
# for the full setup, including the EAS secrets needed for source maps).
# Deliberately NOT prefixed EXPO_PUBLIC_ - app.config.js reads this at
# config-eval time (Node.js, not Metro) and exposes it to the app via
# `extra.sentryDsn` instead. A DSN is a public identifier, not a secret.
SENTRY_DSN=

# Only needed locally if you want `npm run sentry:upload-sourcemaps` to
# work from your own machine - on EAS Build these are set as EAS secrets
# instead (`eas secret:create`), never committed here. SENTRY_AUTH_TOKEN
# in particular is a real secret - unlike SENTRY_DSN above, never share it.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
